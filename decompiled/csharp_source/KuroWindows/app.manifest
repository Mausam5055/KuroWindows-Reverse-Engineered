<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!--
    Per-Monitor V2 DPI awareness is required for capture correctness on
    mixed-DPI multi-monitor setups. Without it the process is system-DPI
    aware: WinForms Screen bounds and DXGI output descriptions come back
    DPI-virtualized (logical), while DXGI duplication textures and
    low-level input-hook coordinates are physical. On a 125%-scaled
    secondary display that mismatch makes the capture pipeline expect
    e.g. 1536x864 while DXGI delivers 1920x1080, failing every segment
    ("DXGI texture size changed"), and skews cursor->display mapping.
    With PerMonitorV2 every coordinate source in the process is physical.
  -->
  <!--
    Declaring a custom manifest REPLACES the SDK default, so OS support
    declarations must come along: without the Windows 10 supportedOS GUID
    the compatibility shims report an older OS to the process, breaking
    WinRT interop (observed: Windows.Graphics.Capture session creation
    failing with "Failed to create a CCW ... cast is not valid").
  -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
